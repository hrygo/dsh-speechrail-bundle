{
  "name": "dsh-speechrail-bundle-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "gen:typert": "node scripts/generate-typert.mjs --skip-diagnostics",
    "build:host": "pnpm --filter @hrygo/dsh-speechrail-bundle run build:host",
    "build:client": "pnpm --filter @hrygo/dsh-speechrail-bundle run build:client",
    "build": "pnpm gen:typert && pnpm typecheck && pnpm build:host && pnpm build:client",
    "test": "pnpm gen:typert && vitest run",
    "test:host": "pnpm gen:typert && vitest run --project host",
    "test:client": "pnpm gen:typert && vitest run --project client",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "verify:baseline": "python3 tools/verify-upstream.py --git",
    "verify": "pnpm verify:baseline && pnpm build && pnpm check:journal && pnpm check:release && pnpm check:package && pnpm check:tool-schema && pnpm test",
    "check:journal": "node tools/check-journal-unit.mjs",
    "verify:ci": "python3 tools/verify-upstream.py && pnpm build && pnpm check:journal && pnpm check:release && pnpm check:package && pnpm check:tool-schema && pnpm test",
    "check:release": "node tools/check-release-consistency.mjs",
    "check:tool-schema": "node tools/check-tool-schema.mjs --optional",
    "check:package": "node tools/check-package-contents.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
