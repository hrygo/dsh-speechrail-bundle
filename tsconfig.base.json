{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // The Typert generator only recognises Remote markers whose symbols live in a
    // workspace package named @deepseek-ai/dsh-typert-protocol. This alias points
    // type resolution at the private shim under packages/typert-protocol; runtime
    // and bundling keep resolving the published npm package.
    "paths": {
      "@deepseek-ai/dsh-typert-protocol": ["./packages/typert-protocol/src/index.ts"]
    }
  }
}
